# ─────────────────────────────────────────────────────────────────────────────
# NEA Precision Skin: server settings. Copy to .env.local (development) or set in
# the server's environment (production). NEVER commit real values. Nothing here
# uses NEXT_PUBLIC_ except the site address, so no secret reaches the browser.
# Make a random secret:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# Public site address (sitemap, canonical URLs, emails, sign-in redirects)
NEXT_PUBLIC_SITE_URL=https://neaprecisionskin.com

# ── Database (PostgreSQL 16, in Canada) ──
# The website connects as nea_app (cannot bypass Row Level Security).
DATABASE_URL=postgres://nea_app:CHANGE_ME@db-host:5432/nea?sslmode=require
# Used only by `npm run db:migrate`, `npm run admin:create` and backups (the table owner).
DATABASE_OWNER_URL=postgres://nea_owner:CHANGE_ME@db-host:5432/nea?sslmode=require
# Optional: connections per app server (default 10) and the slow-query log threshold in ms (default 50)
DB_POOL_MAX=10
DB_SLOW_MS=50

# ── Security secrets (each one different, each 32 random bytes) ──
AUTH_PEPPER=
SESSION_SECRET=
DATA_ENC_KEY=
ALTCHA_HMAC_KEY=
# Secret staff page address, e.g. staff-7f3k2a9d (letters, numbers, dashes). The staff page is at https://site/<ADMIN_PATH>
ADMIN_PATH=
# Protects the daily maintenance call and the Instagram token refresh
CRON_SECRET=

# ── Email (NEA's SMTP server): sign-in codes, parent consent, staff invites ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NEA Precision Skin <no-reply@neaprecisionskin.com>"
# Optional: email this address when a website form comes in
STAFF_NOTIFY_EMAIL=

# ── Continue with Google (optional; button shows only when set) ──
# Google Cloud Console → Credentials → OAuth client (Web). Redirect URI: https://neaprecisionskin.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Continue with Apple (optional; button shows only when set) ──
# Apple Developer → Identifiers (Services ID) + Keys (Sign in with Apple). Return URL: https://neaprecisionskin.com/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 key on one line with \n for line breaks
APPLE_PRIVATE_KEY=

# ── Website forms ──
# Optional: also forward each lead to Zapier / Make / a CRM. Signed with LEAD_WEBHOOK_SECRET (header X-NEA-Signature).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# ── Search engines ──
# Google Search Console "HTML tag" code and Bing Webmaster Tools "meta tag" code (or verify by DNS instead)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow key (32+ letters/numbers) for fast Bing re-crawls: npm run seo:indexnow
INDEXNOW_KEY=

# ── Nea SI engines (server only). Without them the built-in engine answers. ──
XEVYO_API_KEY=
XEVYO_API_URL=https://chat.xevyo.com/xevyo/v1
XEVYO_MODEL=xevyo
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
GEMINI_HEDGE_MS=1500
GEMINI_FIRST_TOKEN_MS=9000
SI_DEFAULT_ENGINE=xevyo

# ── Optional extras ──
# New Instagram Reels on the site automatically. See README → "Reels".
INSTAGRAM_ACCESS_TOKEN=
# Glow Club clinic codes (code=points=label, comma separated). Change them whenever you like.
CLUB_CODES=
